# Domains Traefik routes to this service (see docker-compose.yml).
# Copy this file to .env and fill in your own domains.
# *_PUBLIC must be reachable from any browser — it's baked into the
# frontend's JS bundle as the API base URL at build time.
# If you only route one domain per service, set *_INTERNAL equal to *_PUBLIC.

FRONTEND_DOMAIN_PUBLIC=catvoice.example.com
FRONTEND_DOMAIN_INTERNAL=catvoice.example.com

BACKEND_DOMAIN_PUBLIC=api.catvoice.example.com
BACKEND_DOMAIN_INTERNAL=api.catvoice.example.com

# Email opt-in / reminders (see CLAUDE.md "Email Reminders"). With SMTP_HOST empty
# nothing is sent: emails are written to the backend log and reminders are off.
HMAC_SECRET_KEY=change-me
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=garbellaveus@softcatala.org
EMAIL_FROM_NAME=GarbellaVeus
